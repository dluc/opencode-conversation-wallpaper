{
  "name": "opencode-conversation-wallpaper",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "An animated wallpaper collection and local image backgrounds for OpenCode V2 Desktop conversations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dluc/opencode-conversation-wallpaper.git"
  },
  "homepage": "https://github.com/dluc/opencode-conversation-wallpaper#readme",
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "docs/images"
  ],
  "scripts": {
    "build:gui": "vite build",
    "dev": "vite build --watch",
    "preview:dev": "vite --config vite.preview.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/check-browser.mjs",
    "test:cli": "node scripts/check-cli.mjs",
    "docs:screenshots": "node scripts/check-browser.mjs --update-doc-images",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm test && npm run build:gui && npm run check:package"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.2",
    "@types/node": "^22.0.0",
    "effect": "4.0.6",
    "jsdom": "^26.0.0",
    "playwright": "^1.64.1",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.0.0"
  }
}
